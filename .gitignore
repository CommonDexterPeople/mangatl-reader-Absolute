# Build output — regenerate with `python build.py`
dist/

# Python bytecode
__pycache__/
*.pyc

# Runtime model cache (_MODEL_CACHE_DIR in server.py).
# The LaMa checkpoint is downloaded on demand and MD5-verified by
# _download_lama_checkpoint() — it must never be committed (~205 MB).
models/

# Patch leftovers
*.orig
*.rej

# Local OCR test pages — real manga scans, not ours to redistribute.
# Tests look for them here and skip cleanly when absent.
eval_samples/
